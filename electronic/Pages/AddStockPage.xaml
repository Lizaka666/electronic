<Page x:Class="electronic.Pages.AddStockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поступление на склад">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border BorderThickness="1" BorderBrush="LightGray" Padding="20" Background="White" CornerRadius="5">
            <StackPanel Width="300">
                <TextBlock x:Name="txtTitle" Text="Поступление товара" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>

                <TextBlock Text="Выберите объем памяти:" Margin="0,0,0,5" Foreground="Gray"/>
                <ComboBox x:Name="cmbSize" DisplayMemberPath="sizeGb" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Количество (шт.):" Margin="0,0,0,5" Foreground="Gray"/>
                <TextBox x:Name="txtCount" Text="10" Padding="5" Margin="0,0,0,20" TextAlignment="Center" FontSize="16" FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Пополнить склад" Click="btnSaveStock_Click" Background="#A9DFBF" FontWeight="Bold" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="Отмена" Click="btnCancel_Click" Background="#E5E7E9" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>