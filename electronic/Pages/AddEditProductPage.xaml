<Page x:Class="electronic.Pages.AddEditProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:electronic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Редактирование товара">

    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <TextBlock Text="Данные товара" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Название:"/>
            <TextBox x:Name="txtName" Text="{Binding name}" Margin="0,0,0,10" Padding="3"/>

            <TextBlock Text="Производитель:"/>
            <ComboBox x:Name="cmbManufacturer" Margin="0,0,0,10" Padding="3" DisplayMemberPath="manufacturer1"/>

            <TextBlock Text="Категория:"/>
            <ComboBox x:Name="cmbCategory" Margin="0,0,0,10" Padding="3" DisplayMemberPath="category1"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="txtDescription" Text="{Binding description}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Padding="3"/>

            <TextBlock Text="Состав:"/>
            <TextBox x:Name="txtConsist" Text="{Binding consist}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" Padding="3"/>


            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Базовая цена:"/>
                    <!-- Добавили TextChanged -->
                    <TextBox MaxLength="18" x:Name="txtPrice" Text="{Binding oldPrice}" Padding="3" TextChanged="Calculate_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                    <TextBlock Text="Скидка (%):"/>
                    <!-- Добавили TextChanged -->
                    <TextBox MaxLength="3" x:Name="txtDiscount" Text="{Binding discountPercent}" Padding="3" TextChanged="Calculate_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                    <TextBlock Text="Итог. цена:"/>
                    <!-- Сделали серым и запретили редактировать вручную -->
                    <TextBox x:Name="txtFinalPrice" Text="{Binding price}" Padding="3" IsReadOnly="True" Background="#F0F0F0"/>
                </StackPanel>
            </Grid>

            <!-- Оставили только просмотр текущего фото, если оно есть -->
            <TextBlock Text="Изображение:"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Image x:Name="imgProduct" Source="{Binding ImagePath}" Width="100" Height="100" Stretch="Uniform"/>
                <Button Content="Выбрать изображение" Click="SelectImage_Click"
            VerticalAlignment="Center" Margin="10,0,0,0" Padding="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" Click="Save_Click" Width="120" Padding="5" Margin="0,0,10,0" Background="#FFD1E7DD"/>
                <Button Content="Отмена" Click="Cancel_Click" Width="120" Padding="5" Background="#FFF8D7DA"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
