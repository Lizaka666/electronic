<Page x:Class="electronic.Pages.AddEditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Данные пользователя">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border BorderThickness="1" BorderBrush="LightGray" Padding="20" Background="White" CornerRadius="5">
            <StackPanel Width="300">
                <TextBlock x:Name="txtTitle" Text="Новый пользователь" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Фамилия (обязательно):" Foreground="Gray"/>
                <TextBox x:Name="txtSurname" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Имя (обязательно):" Foreground="Gray"/>
                <TextBox x:Name="txtName" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Логин (обязательно):" Foreground="Gray"/>
                <TextBox x:Name="txtLogin" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Пароль (обязательно):" Foreground="Gray"/>
                <TextBox x:Name="txtPassword" Padding="5" Margin="0,0,0,10"/>

               
                <TextBlock Text="Роль пользователя:" Foreground="Gray"/>
                <ComboBox x:Name="cmbRole" DisplayMemberPath="role1" Padding="5" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" Click="btnSave_Click" Width="100" Background="#A9DFBF" FontWeight="Bold" Margin="0,0,10,0" Padding="5"/>
                    <Button Content="Отмена" Click="btnCancel_Click" Width="100" Background="#E5E7E9" Padding="5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>