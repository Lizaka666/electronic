<Page x:Class="electronic.Pages.AddOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оформление нового заказа">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border BorderBrush="LightGray" BorderThickness="1" Padding="20" Background="White" CornerRadius="5">
            <StackPanel Width="300">
                <TextBlock Text="Новый заказ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Выберите клиента:" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbUsers" DisplayMemberPath="FullName" Padding="5" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Создать" Click="btnCreate_Click" Width="100" Background="#A9DFBF" FontWeight="Bold" Margin="0,0,10,0" Padding="5"/>
                    <Button Content="Отмена" Click="btnCancel_Click" Width="100" Background="#E5E7E9" Padding="5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>