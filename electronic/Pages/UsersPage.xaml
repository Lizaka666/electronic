<Page x:Class="electronic.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление пользователями">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Список пользователей" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Добавить пользователя" Click="btnAddUser_Click" Background="#A9DFBF" FontWeight="Bold" Padding="15,5"/>
        </Grid>

        <ListView x:Name="listUsers" Grid.Row="1" Margin="5" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BorderThickness="1" CornerRadius="4" BorderBrush="LightGray" Padding="10">
                        <Grid>
                            <!-- Оставили ровно 3 колонки, email удален -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. ФИО и Роль (Колонка 0) -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding RoleName}" Foreground="DarkBlue" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 2. Логин (Колонка 1) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Логин:" Foreground="Gray" FontSize="12"/>
                                <TextBlock Text="{Binding UserRecord.login}"/>
                            </StackPanel>

                            <!-- 3. Кнопки (Колонка 2) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Редактировать" Click="btnEdit_Click" Background="#D4E6F1" Margin="0,0,10,0" Padding="10,5"/>
                                <Button Content="Удалить" Click="btnDelete_Click" Background="#FF6B6B" Foreground="White" Padding="10,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2" Content="Назад" Click="btnBack_Click" Background="#E5E7E9" Width="100" Padding="10" HorizontalAlignment="Right" Margin="5"/>
    </Grid>
</Page>