<Page x:Class="electronic.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:electronic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">
    <Grid Background="AliceBlue">
        <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" BorderBrush="CadetBlue" BorderThickness="1" Padding="15">
            <StackPanel>

                <TextBlock Text="Регистрация" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Фамилия:"/>
                <TextBox x:Name="txtSurname" Margin="0,0,0,10" Height="22"/>

                <TextBlock Text="Имя:"/>
                <TextBox x:Name="txtName" Margin="0,0,0,10" Height="22"/>

                <TextBlock Text="Отчество (если есть):"/>
                <TextBox x:Name="txtPatronymic" Margin="0,0,0,10" Height="22"/>

                <TextBlock Text="Логин:"/>
                <TextBox x:Name="txtLogin" Margin="0,0,0,10" Height="22"/>

                <TextBlock Text="Пароль:"/>
                <PasswordBox x:Name="pbPassword" Margin="0,0,0,10" Height="22"/>

                <TextBlock Text="Повторите пароль:"/>
                <PasswordBox x:Name="pbPasswordConfirm" Margin="0,0,0,20" Height="22"/>

                <Button x:Name="btnRegister" Content="Зарегистрироваться" Click="btnRegister_Click" Background="CadetBlue" Foreground="White" Height="25" Margin="0,0,0,10"/>

                <Button x:Name="btnCancel" Content="Назад" Click="btnCancel_Click" Background="White" Height="25"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
