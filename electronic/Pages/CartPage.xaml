<Page x:Class="electronic.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:electronic.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ваша корзина" FontSize="20" FontWeight="Bold" Margin="5"/>

        <!-- Список товаров в стиле главной страницы -->
        <ListView x:Name="listCart" Grid.Row="1" Margin="5" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" BorderThickness="1" CornerRadius="4" BorderBrush="LightGray" Background="White" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Изображение товара -->
                            <Image Grid.Column="0" Source="{Binding ImagePath}" Width="100" Height="100" Stretch="Uniform"/>

                            <!-- Информация и выбор памяти -->
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>

                                <TextBlock Text="Размер памяти:" Foreground="Gray" Margin="0,10,0,2"/>
                                <!-- ComboBox для выбора доступных вариантов со склада -->
                                <ComboBox Width="150" HorizontalAlignment="Left" Padding="3"
                                          ItemsSource="{Binding AvailableSizes}" 
                                          DisplayMemberPath="SizeLabel"
                                          SelectedItem="{Binding SelectedSize}"
                                          SelectionChanged="cmbSize_SelectionChanged"
                                          Tag="{Binding}"/>

                                <TextBlock Foreground="DarkRed" FontSize="11" Margin="0,2,0,0" 
                                           Text="{Binding StockMaxCount, StringFormat='На складе: {0} шт.'}"/>
                            </StackPanel>

                            <!-- Цены и управление количеством -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
               Text="{Binding ItemTotal, StringFormat='{}{0:N0} ₽'}"/>
                                <TextBlock Foreground="Gray" HorizontalAlignment="Right" FontSize="12" Margin="0,0,0,10"
               Text="{Binding ProductPrice, StringFormat='{}{0:N0} ₽ за шт.'}"/>

                                <!-- Блок + / - -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <Button Content=" - " Width="30" Background="#E5E7E9" Click="btnMinus_Click"/>
                                    <TextBlock Text="{Binding CurrentCount}" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                    <Button Content=" + " Width="30" Background="#D4E6F1" Click="btnPlus_Click"/>
                                </StackPanel>

                                <Button Content="Удалить" Click="btnRemove_Click" Background="#FF6B6B" Foreground="White" Width="100" Padding="3"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Нижняя панель с итогами -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="Итого к оплате:" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
            <TextBlock x:Name="txtTotal" Text="0 ₽" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,20,0"/>

            <Button x:Name="btnOrder" Content="Оформить заказ" Click="btnOrder_Click" Background="#D4E6F1" Width="150" Padding="10" Margin="0,0,10,0"/>
            <Button x:Name="btnBack" Content="Назад" Click="btnBack_Click" Background="#E5E7E9" Width="100" Padding="10"/>
        </StackPanel>
    </Grid>
</Page>
