<Page x:Class="electronic.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border BorderThickness="1" BorderBrush="LightGray" Padding="30" Background="White" CornerRadius="8">
            <StackPanel Width="300">
                <TextBlock Text="Личный кабинет" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Фамилия:" Foreground="Gray"/>
                <TextBox x:Name="txtSurname" MaxLength="50" PreviewTextInput="LettersOnly_PreviewTextInput" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Имя:" Foreground="Gray"/>
                <TextBox x:Name="txtName" MaxLength="50" PreviewTextInput="LettersOnly_PreviewTextInput" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Логин:" Foreground="Gray"/>
                <TextBox x:Name="txtLogin" MaxLength="50" PreviewTextInput="NoSpaces_PreviewTextInput" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Пароль:" Foreground="Gray"/>
                <TextBox x:Name="txtPassword" MaxLength="50" PreviewTextInput="NoSpaces_PreviewTextInput" Padding="5" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить изменения" Click="btnSave_Click" Width="150" Background="#A9DFBF" FontWeight="Bold" Margin="0,0,10,0" Padding="8"/>
                    <Button Content="Отмена" Click="btnCancel_Click" Width="100" Background="#E5E7E9" Padding="8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>